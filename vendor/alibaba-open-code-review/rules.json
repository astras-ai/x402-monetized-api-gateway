{
  "repo": "alibaba/open-code-review",
  "version": "2.4.0",
  "rules": [
    {
      "id": "SEC-001",
      "name": "Hardcoded Private Key Detection",
      "severity": "CRITICAL",
      "pattern": "0x[a-fA-F0-9]{64}|0x71C7[0-9a-fA-F]{34}"
    },
    {
      "id": "X402-002",
      "name": "PAY_TO Secret Injection Check",
      "severity": "HIGH",
      "pattern": "PAY_TO\\s*=\\s*['\"]0x"
    },
    {
      "id": "PERF-003",
      "name": "Unbounded Edge Loop Audit",
      "severity": "MEDIUM",
      "pattern": "while\\(true\\)|for\\(;;\\)"
    }
  ]
}
